# ============================================================
# TASKFLOW - Environment Configuration
# ============================================================
# Copy this file to .env and update the values as needed.
# DO NOT commit real secrets or credentials into version control.

# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=taskflow-development-secret-key-change-this-in-production-12345
JWT_SECRET_KEY=taskflow-development-jwt-secret-key-change-this-in-production-67890
JWT_ACCESS_TOKEN_EXPIRES_DAYS=7

# Frontend Client URL (for CORS and email redirect links)
FRONTEND_URL=http://localhost:5173

# Database URL
# Default is SQLite file in backend/database/taskflow.db
# For PostgreSQL later: postgresql://username:password@localhost:5432/taskflow_db
DATABASE_URL=sqlite:///database/taskflow.db

# ============================================================
# SMTP / Email Service Configuration
# ============================================================
# Configure a real SMTP provider (e.g., Gmail App Password, SendGrid, Mailgun, Brevo)
# If left blank, TaskFlow will log emails safely and notify via in-app notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-secure-app-password
MAIL_FROM=TaskFlow <no-reply@taskflow.local>

# ============================================================
# OAuth 2.0 Provider Configuration (Google & GitHub)
# ============================================================
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/oauth/google/callback

# GitHub Developer Settings: https://github.com/settings/developers
# Authorized callback URL: http://localhost:5000/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/oauth/github/callback

# ============================================================
# Clerk Authentication Configuration
# ============================================================
# Clerk Dashboard: https://dashboard.clerk.com
# Find your keys under "API Keys"
# Frontend Publishable Key (used by React)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
# Backend Secret Key (used by Flask - NEVER expose to frontend)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# Optional: Explicit JWKS URL (auto-derived if left blank)
CLERK_JWKS_URL=
